\contentsline {figure}{\numberline {1}{\ignorespaces Overview of the three Europe–Northeast Asia corridors considered in this study}}{6}{figure.caption.2}%
\contentsline {figure}{\numberline {2}{\ignorespaces Overview of the methodological pipeline used to compute GC and sea-only routes, derive time/fuel/CO$_2$ metrics, and generate reproducible tables and maps.}}{13}{figure.caption.5}%
\contentsline {figure}{\numberline {3}{\ignorespaces Geometric GC-chain corridor distances by corridor and waypoint variant for Rotterdam--Yokohama.}}{14}{figure.caption.6}%
\contentsline {figure}{\numberline {4}{\ignorespaces Sea-only (A*) distance by corridor and waypoint variant. The Northern Sea Route remains shortest, followed by Suez and Cape.}}{15}{figure.caption.7}%
\contentsline {figure}{\numberline {5}{\ignorespaces Routing-method effect on distance: GC-chain vs sea-only per corridor/variant.}}{16}{figure.caption.8}%
\contentsline {figure}{\numberline {6}{\ignorespaces GC-chain to sea-only distance delta (\%) by corridor and waypoint philosophy.}}{17}{figure.caption.9}%
\contentsline {figure}{\numberline {7}{\ignorespaces Voyage duration by corridor and variant for sea-only routes under corridor-typical service speeds. NSR remains shortest by distance, but its time advantage over SUEZ compresses under the lower NSR speed.}}{18}{figure.caption.12}%
\contentsline {figure}{\numberline {8}{\ignorespaces Compression from distance to time under corridor-typical speeds. Points show corridor medians across variants, normalised by SUEZ. NSR’s distance advantage translates into a smaller time advantage once realistic speeds are applied.}}{19}{figure.caption.13}%
\contentsline {figure}{\numberline {9}{\ignorespaces Sea-only distance vs.\ indicative voyage duration under corridor speeds. The dashed line shows the duration each route would have at SUEZ speed. NSR points lie above this line because NSR speed is lower.}}{20}{figure.caption.14}%
\contentsline {figure}{\numberline {10}{\ignorespaces NSR break-even speed required to match SUEZ voyage time for paired variants. If NSR average speed drops below this band, its schedule advantage disappears.}}{21}{figure.caption.15}%
\contentsline {figure}{\numberline {11}{\ignorespaces Estimated total fuel consumption by corridor and variant for sea-only routes (main + auxiliary). CO$_2$ follows the same pattern because it scales with total fuel.}}{22}{figure.caption.16}%
\contentsline {figure}{\numberline {12}{\ignorespaces Endpoint sensitivity for sea-only distances: Yokohama versus Busan by corridor and waypoint variant. All corridors lengthen by $\approx 0.64$~k~nm, with the largest relative increase for NSR.}}{22}{figure.caption.17}%
\contentsline {figure}{\numberline {13}{\ignorespaces Equal-speed sensitivity for sea-only routes. Median durations under corridor-typical speeds are compared to an equal-speed scenario, isolating operating-policy effects from geometry.}}{23}{figure.caption.18}%
